datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String?
  role      String     @default("ETUDIANT")
  purchases     Purchase[]
  videoProgress VideoProgress[]
  quizResults   QuizResult[]
}

model Product {
  id          String   @id @default(cuid())
  nom         String
  description String?
  prix        Float
  image       String?
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Formation {
  id           String     @id @default(cuid())
  title        String
  description  String
  price        Float
  thumbnailUrl String?
  videos       Video[]
  qcms         Qcm[]
  purchases    Purchase[]
  quizResults  QuizResult[]
}

model Video {
  id          String    @id @default(cuid())
  title       String
  videoUrl    String
  order       Int       @default(0)
  formationId   String
  formation     Formation       @relation(fields: [formationId], references: [id])
  videoProgress VideoProgress[]
}

model Qcm {
  id            String    @id @default(cuid())
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  formationId   String
  formation     Formation @relation(fields: [formationId], references: [id])
}

model Purchase {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  formationId String
  formation   Formation @relation(fields: [formationId], references: [id])
  status      String    @default("PAID")
}

model VideoProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id])
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, videoId])
}

model QuizResult {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  formationId String
  formation   Formation @relation(fields: [formationId], references: [id])
  score       Int
  total       Int
  passed      Boolean   @default(false)
  createdAt   DateTime  @default(now())
}
